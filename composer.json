{
    "name": "sistem_atc/asaas-laravel",
    "description": "SDK Asaas para Laravel com webhooks e metodos de envios",
    "keywords": ["asaas", "laravel", "sdk", "payments", "gateway"],
    "homepage": "https://github.com/sistem-atc/asaas-laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Kleber Pracidelli",
            "email": "sistem.atc@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "SistemAtc\\Asaas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SistemAtc\\Asaas\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SistemAtc\\Asaas\\AsaasServiceProvider"
            ],
            "aliases": {
                "Asaas": "SistemAtc\\Asaas\\Facades\\Asaas"
            }
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.9",
        "pestphp/pest": "^4.3"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "./vendor/bin/pest"
    }
}
